          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select date_trunc('second', h.sample_time)\n    ,count(*) as event_type        \n    ,case when h.state = 'idle in transaction' then 'idle in transaction'\n     else COALESCE(wait_event_type ,'[NULL]') \n     end as wait_event_type\nfrom adm.pg_stat_activity_history h \nwhere  $__timeFilter( h.sample_time ) \nand ( COALESCE(wait_event_type ,'[NULL]') in ($wait_event_type) or ( 'idle in transaction' in ($wait_event_type) and h.state = 'idle in transaction' ) ) \ngroup  by date_trunc('second', h.sample_time) ,  \ncase when h.state = 'idle in transaction' then 'idle in transaction' else COALESCE(wait_event_type ,'[NULL]') end; ",
          "refId": "A",
