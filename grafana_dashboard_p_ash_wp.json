      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRESQL-P01}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "with q as \n ( select h.query, h.query_id, count(1) as avg_activity\n    ,round(avg(h.duration)) as avg_duration_ms \n    ,date_trunc('second', h.sample_time) as sample_time\n    ,h.datid \nfrom adm.pg_stat_activity_history h \nwhere $__timeFilter( h.sample_time ) \nand ( COALESCE(wait_event_type ,'[NULL]') in ($wait_event_type) or ( 'idle in transaction' in ($wait_event_type) and h.state = 'idle in transaction' ) )\ngroup by h.datid, h.query , h.query_id, date_trunc('second', h.sample_time) ) \nselect round( sum(q.avg_activity) / (select count(distinct sample_time) from q) ,3) as avg_activity\n  ,max(avg_duration_ms) as max_duration_ms \n  ,d.datname \n  ,q.query_id::text\n  ,substr(query, 1, 500 ) as query_substr1000   \nfrom q left join pg_catalog.pg_database d on q.datid = d.oid \ngroup by d.datname, q.query, q.query_id order by 1 desc ;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
